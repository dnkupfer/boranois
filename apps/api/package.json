{
  "name": "@boranois/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "host-code": "tsx --env-file-if-exists=.env src/host-code.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@boranois/shared": "*",
    "@google/genai": "^2.30.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
