PORT=8080
# Leave empty to use the local JSON file store (apps/api/.data/dev.json).
DATABASE_URL=
# Leave empty to send templates as written (no AI phrasing, no reply classification).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest   (lite is enough for short texts and has its own quota)
# Who sees /admin: sign in with one of these e-mails (magic link). Comma-separated.
ADMIN_EMAILS=
# For scripts only: GET /api/analytics/summary and /api/admin/overview with header x-admin-token.
ADMIN_TOKEN=
# E-mail for magic links (optional). Without both, links are only logged and the UI hides "Entrar com e-mail".
RESEND_API_KEY=
EMAIL_FROM="Boranois <boranois@seudominio.com.br>"
# Cost guards (defaults shown): model calls per session/hour, per IP/hour, per day; writes per IP per 10 min.
# AI_PER_SESSION_HOURLY=60
# AI_PER_IP_HOURLY=200
# AI_DAILY_CAP=2000
# WRITES_PER_IP_10MIN=300
# Public URL of the web app: magic links point here.
WEB_ORIGIN=http://localhost:5173
# Where the catalogue lives (default: ../../content from apps/api).
# CONTENT_DIR=
