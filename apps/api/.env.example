PORT=8080
# Leave empty to use the local JSON file store (apps/api/.data/dev.json).
DATABASE_URL=
# Leave empty to send templates as written (no AI phrasing, no reply classification).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest   (lite is enough for short texts and has its own quota)
# Protects GET /api/analytics/summary.
ADMIN_TOKEN=
# Public URL of the web app: magic links point here.
WEB_ORIGIN=http://localhost:5173
# Where the catalogue lives (default: ../../content from apps/api).
# CONTENT_DIR=
