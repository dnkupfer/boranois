PORT=8080
# Leave empty to use the local JSON file store (apps/api/.data/dev.json).
DATABASE_URL=
# Leave empty to use the offline keyword scorer instead of Gemini.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Minimum score (0-100) for a "share" decision.
SHARE_THRESHOLD=60
# Used by POST /api/admin/host-codes.
ADMIN_TOKEN=
# Public URL of the web app, used in printed links.
WEB_ORIGIN=http://localhost:5173
